# Copy this file to .env.local for running on your computer, and add the same
# values in Vercel (Project > Settings > Environment Variables).
# Never commit real values. The README explains where each one comes from.

# Supabase > Project Settings > API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (older projects call it the "anon public" key). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The "secret" key (older projects call it "service_role"). Server only. Keep it private.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Only these Google accounts can sign in. Separate them with commas.
ALLOWED_EMAILS=you@gmail.com,wife@gmail.com

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
# Which Claude model to use. A fast, low-cost model is the default.
CLAUDE_MODEL=claude-haiku-5-5
